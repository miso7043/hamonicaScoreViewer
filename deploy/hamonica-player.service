[Unit]
Description=Hamonica MusicXML player
After=network.target

[Service]
User=hamonica
Group=hamonica
WorkingDirectory=/opt/hamonica-player
EnvironmentFile=/etc/hamonica-player.env
ExecStart=/opt/hamonica-player/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8030 --workers 2 --timeout 60 --access-logfile -
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hamonica-player

[Install]
WantedBy=multi-user.target
